{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "lcsc": "https://www.lcsc.com/product-detail/",
    "pcb": "https://lucsoft.local/ns/pcb#",

    "Component": "pcb:Component",
    "Assembly": "pcb:Assembly",
    "Pin": "pcb:Pin",
    "Rule": "pcb:Rule",

    "name": "schema:name",
    "description": "schema:description",
    "manufacturer": "schema:manufacturer",
    "mpn": "schema:mpn",
    "category": "schema:category",

    "lcscId": "pcb:lcscId",
    "package": "pcb:package",
    "tier": "pcb:jlcAssemblyTier",
    "stock": "pcb:stock",
    "priceUsd": "pcb:unitPriceUsd",

    "datasheet": { "@id": "pcb:datasheet", "@type": "@id" },

    "pins": { "@id": "pcb:hasPin", "@container": "@set" },
    "number": "pcb:pinNumber",
    "type": "pcb:pinType",
    "vMax": "pcb:absoluteMaxVoltage",
    "vMin": "pcb:absoluteMinVoltage",
    "iMaxMa": "pcb:absoluteMaxCurrentMa",
    "contact": "pcb:contactDesignation",
    "source": "pcb:provenanceSource",

    "parameters": { "@id": "pcb:parameter", "@container": "@index" },
    "value": "schema:value",
    "unit": "schema:unitCode",
    "tolerance": "pcb:tolerance",

    "rules": { "@id": "pcb:hasRule", "@container": "@set" },
    "id": "pcb:ruleId",
    "severity": "pcb:severity",
    "requires": "pcb:requires",
    "appliesTo": "pcb:appliesToPin",

    "provenance": { "@id": "pcb:provenance", "@container": "@index" },
    "retrieved": { "@id": "pcb:retrievedAt", "@type": "schema:Date" },
    "seeAlso": { "@id": "schema:subjectOf", "@type": "@id" },

    "designVerdict": "pcb:designVerdict",
    "note": "pcb:note",
    "notes": { "@id": "pcb:note", "@container": "@set" },

    "composedOf": { "@id": "pcb:composedOf", "@container": "@set" },
    "quantity": "pcb:quantity",
    "role": "pcb:role",

    "envelope": { "@id": "pcb:envelope", "@type": "@json" },
    "systemLimits": { "@id": "pcb:systemLimits", "@type": "@json" },
    "thermalLimit": { "@id": "pcb:thermalLimit", "@type": "@json" },
    "inrush": { "@id": "pcb:inrush", "@type": "@json" },
    "cabling": { "@id": "pcb:cabling", "@type": "@json" },
    "connector": { "@id": "pcb:connector", "@type": "@json" },
    "dataInterface": { "@id": "pcb:dataInterface", "@type": "@json" },
    "failureModes": { "@id": "pcb:failureModes", "@type": "@json" },
    "environment": { "@id": "pcb:environment", "@type": "@json" },
    "sourceOfTruth": { "@id": "pcb:sourceOfTruth", "@type": "@json" },
    "bulkCapacitorSwap": { "@id": "pcb:bulkCapacitorSwap", "@type": "@json" }
  }
}
