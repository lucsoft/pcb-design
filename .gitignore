# Cached datasheets: large, re-fetchable with tools/ds.py fetch.
kb/datasheets/*.pdf
kb/datasheets/*.txt

# Never commit JLCPCB API credentials.
.mcp.local.json

# Python bytecode
__pycache__/
*.pyc

# Mermaid render check output
/tmp-render/

# npm pulls the bridge server dependencies in; they are re-fetchable
# with `npm install` and large enough to drown a diff.
node_modules/
tools/eda-bridge/dist/
tools/eda-bridge/*.eext
